{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.async.local/v1/events/core.thread-state-changed.schema.json",
  "title": "Core.ThreadStateChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "org_id",
    "entity_ref",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "Core.ThreadStateChanged" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "format": "uuid" },
    "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
    "trace_id": { "type": ["string", "null"] },
    "ordering_key": {
      "type": ["string", "null"],
      "description": "Recommended: thread_id"
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "thread" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "from_state", "to_state", "reason"],
      "properties": {
        "thread_id": { "type": "string", "format": "uuid" },
        "from_state": { "type": "string", "enum": ["OPEN", "BLOCKED", "DECIDED", "ARCHIVED"] },
        "to_state": { "type": "string", "enum": ["OPEN", "BLOCKED", "DECIDED", "ARCHIVED"] },
        "reason": { "type": "string" }
      }
    }
  }
}

