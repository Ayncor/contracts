{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.async.local/v1/events/core.message-version-created.schema.json",
  "title": "Core.MessageVersionCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "org_id",
    "entity_ref",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "Core.MessageVersionCreated" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "format": "uuid" },
    "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
    "trace_id": { "type": ["string", "null"] },
    "ordering_key": {
      "type": ["string", "null"],
      "description": "Recommended: message_id"
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "message" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "version", "body", "format", "created_at", "created_by"],
      "properties": {
        "message_id": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 2 },
        "body": { "type": "string" },
        "format": { "type": "string", "enum": ["PLAIN", "MARKDOWN"] },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "format": "uuid" }
      }
    }
  }
}

