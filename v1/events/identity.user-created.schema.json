{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.async.local/v1/events/identity.user-created.schema.json",
  "title": "Identity.UserCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "org_id",
    "entity_ref",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "Identity.UserCreated" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "format": "uuid" },
    "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
    "trace_id": { "type": ["string", "null"] },
    "ordering_key": { "type": ["string", "null"] },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "user" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "email", "display_name", "status"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "DELETED"] }
      }
    }
  }
}

