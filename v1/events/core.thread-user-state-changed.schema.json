{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.async.local/v1/events/core.thread-user-state-changed.schema.json",
  "title": "Core.ThreadUserStateChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "org_id",
    "entity_ref",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "Core.ThreadUserStateChanged" },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "org_id": { "type": "string", "format": "uuid" },
    "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
    "trace_id": { "type": ["string", "null"] },
    "ordering_key": {
      "type": ["string", "null"],
      "description": "Recommended: thread_id"
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "thread_user_state" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "user_id", "status", "needs_response", "priority_override"],
      "properties": {
        "thread_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "enum": ["IN_INBOX", "ARCHIVED", "SNOOZED"] },
        "needs_response": { "type": "boolean" },
        "snoozed_until": { "type": ["string", "null"], "format": "date-time" },
        "last_read_message_id": { "type": ["string", "null"], "format": "uuid" },
        "last_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "priority_override": { "type": "string", "enum": ["NONE", "LOW", "HIGH"] }
      }
    }
  }
}
